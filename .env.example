# Development Environment Configuration
# For production, see .env.production.example

# Environment identifier (dev/staging/production)
BANI_ENVIRONMENT=dev

# Server Configuration
BANI_SERVER_HOST=0.0.0.0
BANI_SERVER_PORT=8080
BANI_DOCKER_APP_PORT=28080
BANI_DOCKER_POSTGRES_PORT=5435
BANI_DOCKER_REDIS_PORT=6381
BANI_DOCKER_MINIO_API_PORT=9102
BANI_DOCKER_MINIO_CONSOLE_PORT=9103
BANI_BACKEND_URL=http://localhost:28080

# Database Configuration
BANI_DATABASE_DSN=postgres://postgres:postgres@localhost:5435/bani?sslmode=disable

# Redis Configuration
BANI_REDIS_ADDR=localhost:6381
BANI_REDIS_PASSWORD=
BANI_REDIS_DB=0

# JWT Configuration
# NOTE: Must be at least 32 characters in production
BANI_JWT_SECRET=dev-secret-change-me-for-production

# JWT Token TTL
BANI_JWT_TOKEN_TTL=24h

# Logger Configuration
BANI_LOGGER_LEVEL=info
BANI_LOGGER_FORMAT=console

# CORS Configuration
# Comma-separated list of allowed origins (wildcard * rejected in production)
BANI_CORS_ALLOWED_ORIGINS=*

# Database Connection Pool
# BANI_DATABASE_MAX_CONNS=20
# BANI_DATABASE_MIN_CONNS=2
# BANI_DATABASE_MAX_CONN_LIFETIME=1h

# Storage Configuration (S3/MinIO for avatars)
BANI_STORAGE_ENDPOINT=localhost:9102
BANI_STORAGE_PUBLIC_BASE_URL=http://localhost:9102
BANI_STORAGE_BUCKET=bani-avatars
BANI_STORAGE_ACCESS_KEY=minioadmin
BANI_STORAGE_SECRET_KEY=minioadmin
BANI_STORAGE_REGION=us-east-1
BANI_STORAGE_USE_SSL=false

# OAuth Configuration (Social Login)
BANI_OAUTH_VK_CLIENT_ID=
BANI_OAUTH_VK_CLIENT_SECRET=
BANI_OAUTH_VK_REDIRECT_URL=http://localhost:28080/api/v1/auth/oauth/vk/callback
BANI_OAUTH_YANDEX_CLIENT_ID=
BANI_OAUTH_YANDEX_CLIENT_SECRET=
BANI_OAUTH_YANDEX_REDIRECT_URL=http://localhost:28080/api/v1/auth/oauth/yandex/callback
BANI_OAUTH_GOOGLE_CLIENT_ID=
BANI_OAUTH_GOOGLE_CLIENT_SECRET=
BANI_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:28080/api/v1/auth/oauth/google/callback

# Frontend — Yandex Maps API Key
# Used by frontend for BathhouseMap and GeoHeatmap components
VITE_YMAPS_API_KEY=
