# Production Environment Configuration
# Copy this file to .env.production and fill in actual values

# Environment identifier (dev/staging/production)
# Controls strict validation: production requires DSN with sslmode=require, JWT secret 32+ chars
BANI_ENVIRONMENT=production

# Server Configuration
BANI_SERVER_HOST=0.0.0.0
BANI_SERVER_PORT=8080

# Database Configuration (PostgreSQL with PostGIS)
# CRITICAL: Must use sslmode=require in production for secure connections
# Format: postgres://user:password@host:port/dbname?sslmode=require&other=params
BANI_DATABASE_DSN=postgres://user:password@postgres-host:5432/bani?sslmode=require

# Redis Configuration
# CRITICAL: Use strong password in production, consider Redis with AUTH enabled
BANI_REDIS_ADDR=redis-host:6379
BANI_REDIS_PASSWORD=your-secure-redis-password
BANI_REDIS_DB=0

# JWT Configuration
# CRITICAL: Must be at least 32 characters long in production
# Use a cryptographically secure random string. Example generation:
#   openssl rand -hex 32
BANI_JWT_SECRET=your-secure-random-256-bit-key-here-at-least-32-chars

# JWT Token TTL (time until token expires)
BANI_JWT_TOKEN_TTL=24h

# Logger Configuration
# Levels: debug, info, warn, error
# Use info or warn in production
BANI_LOGGER_LEVEL=info
BANI_LOGGER_FORMAT=json

# CORS Configuration
# CRITICAL: Must NOT contain wildcard '*' in production
BANI_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Connection Pool
BANI_DATABASE_MAX_CONNS=20
BANI_DATABASE_MIN_CONNS=2
BANI_DATABASE_MAX_CONN_LIFETIME=1h

# Storage Configuration (S3-compatible object storage for avatars)
# CRITICAL: Use secure credentials and SSL in production
BANI_STORAGE_ENDPOINT=s3.amazonaws.com
BANI_STORAGE_PUBLIC_BASE_URL=https://cdn.yourdomain.com
BANI_STORAGE_BUCKET=bani-avatars-prod
BANI_STORAGE_ACCESS_KEY=your-aws-access-key
BANI_STORAGE_SECRET_KEY=your-aws-secret-key
BANI_STORAGE_REGION=eu-central-1
BANI_STORAGE_USE_SSL=true

# OAuth Configuration (Social Login)
BANI_OAUTH_VK_CLIENT_ID=your-vk-client-id
BANI_OAUTH_VK_CLIENT_SECRET=your-vk-client-secret
BANI_OAUTH_VK_REDIRECT_URL=https://yourdomain.com/api/v1/auth/oauth/vk/callback
BANI_OAUTH_YANDEX_CLIENT_ID=your-yandex-client-id
BANI_OAUTH_YANDEX_CLIENT_SECRET=your-yandex-client-secret
BANI_OAUTH_YANDEX_REDIRECT_URL=https://yourdomain.com/api/v1/auth/oauth/yandex/callback
BANI_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
BANI_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
BANI_OAUTH_GOOGLE_REDIRECT_URL=https://yourdomain.com/api/v1/auth/oauth/google/callback
